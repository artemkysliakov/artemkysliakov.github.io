---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  index?: number;
  /** h2 там, де картки йдуть одразу після h1; h3 — коли над ними є заголовок секції. */
  headingLevel?: 'h2' | 'h3';
}

const { project, class: className = '', index, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const areaNames = { education: 'Освіта', edtech: 'EdTech' };
const colors = ['bg-acid', 'bg-mint', 'tone-coral bg-[#ffd1c8]', 'tone-lilac bg-[#d8ddff]'];
const color = colors[((index ?? 1) - 1) % colors.length];
---

<a class:list={['card folder-card group grid gap-4 md:grid-cols-[3.5rem_9rem_1fr_auto] md:items-center', color, className]} href={`/developments/${project.id}/`}>
  <span class:list={['grid size-11 -rotate-3 place-items-center rounded-full border-2 border-ink font-mono text-sm font-bold transition group-hover:rotate-3', color]}>{index ? String(index).padStart(2, '0') : '→'}</span>
  <div><div class="eyebrow">{areaNames[project.data.area] ?? project.data.area}</div><div class="mt-2 font-mono text-xs text-ink/60">{project.data.year ?? 'проєкт'}</div></div>
  <div>
    <Heading class="text-2xl leading-tight font-black tracking-[-0.035em] transition sm:text-3xl">{project.data.title}</Heading>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">{project.data.description}</p>
  </div>
  <span class="text-2xl font-black transition group-hover:translate-x-1 group-hover:text-coral" aria-hidden="true">↗</span>
</a>

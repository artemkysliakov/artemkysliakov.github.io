---
import { Image } from 'astro:assets';
import qrCode from '../assets/qr-subscriptions.png';

const socials = [
  { label: 'Facebook', href: 'https://www.facebook.com/panaptem' },
  { label: 'Instagram', href: 'https://www.instagram.com/pan_aptem' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@pan_aptem' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/artemkysliakov/' }
];
---

<footer class="site-footer mt-24 border-t-2">
  <div class="shell py-10 lg:py-14">
    <section class="support-panel grid gap-6 md:grid-cols-[1fr_auto] md:items-center" aria-labelledby="support-title">
      <div>
        <div class="footer-kicker">підтримати роботу</div>
        <h2 id="support-title" class="mt-3 text-3xl leading-tight font-black sm:text-4xl">Хочете допомогти моїм проєктам?</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-white/70">РАВЛИК та itnauka.org залишаються безкоштовними й без реклами. Підписка на Базі допомагає оплачувати домени, хостинг і подальшу розробку.</p>
        <a class="support-button mt-6" href="https://base.monobank.ua/9nyWYjQ3C6K2Aw#subscriptions" target="_blank" rel="noreferrer">Підтримати на Базі ↗</a>
      </div>
      <a class="qr-link" href="https://base.monobank.ua/9nyWYjQ3C6K2Aw#subscriptions" target="_blank" rel="noreferrer" aria-label="Відкрити сторінку підтримки на Базі">
        <Image src={qrCode} alt="QR-код для підтримки на Базі" width={168} loading="lazy" />
      </a>
    </section>

    <div class="mt-9 grid gap-7 border-t border-white/20 pt-7 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <div class="footer-kicker">соціальні мережі</div>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-3">
          {socials.map((social) => <a class="footer-link" href={social.href} target="_blank" rel="noreferrer">{social.label} ↗</a>)}
        </div>
      </div>
      <div class="md:text-right">
        <div class="flex flex-wrap gap-x-5 gap-y-3 md:justify-end">
          <a class="footer-link" href="https://ravlyk.org/" target="_blank" rel="noreferrer">РАВЛИК ↗</a>
          <a class="footer-link" href="https://itnauka.org/" target="_blank" rel="noreferrer">itnauka.org ↗</a>
          <a class="footer-link" href="https://drukarnia.com.ua/artem" target="_blank" rel="noreferrer">Друкарня ↗</a>
        </div>
        <div class="mt-4 font-mono text-xs text-white/45">© {new Date().getFullYear()} Артем Кисляков</div>
      </div>
    </div>
  </div>
</footer>

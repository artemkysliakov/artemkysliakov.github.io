---
import { Image } from 'astro:assets';
import qrCode from '../assets/qr-subscriptions.png';
import { site, socials, externalLinks, support } from '../site.config';
---

<footer class="site-footer mt-24 border-t-2">
  <div class="shell py-10 lg:py-14">
    <section class="support-panel grid gap-6 md:grid-cols-[1fr_auto] md:items-center" aria-labelledby="support-title">
      <div>
        <div class="footer-kicker">підтримати роботу</div>
        <h2 id="support-title" class="mt-3 text-3xl leading-tight font-black sm:text-4xl">Хочете допомогти моїм проєктам?</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-white/75">РАВЛИК та itnauka.org залишаються безкоштовними й без реклами. Підписка на Базі допомагає оплачувати домени, хостинг і подальшу розробку.</p>
        <a class="support-button mt-6" href={support.href} target="_blank" rel="noopener noreferrer">{support.label} ↗</a>
      </div>
      <a class="qr-link" href={support.href} target="_blank" rel="noopener noreferrer" aria-label="Відкрити сторінку підтримки на Базі">
        <Image src={qrCode} alt="QR-код для підтримки на Базі" width={168} loading="lazy" />
      </a>
    </section>

    <div class="mt-9 grid gap-7 border-t border-white/20 pt-7 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <div class="footer-kicker">написати мені</div>
        <a class="footer-link mt-3 inline-block text-lg break-all" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="footer-kicker mt-6">соціальні мережі</div>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-3">
          {socials.map((social) => <a class="footer-link" href={social.href} target="_blank" rel="noopener noreferrer me">{social.label} ↗</a>)}
        </div>
      </div>
      <div class="md:text-right">
        <div class="flex flex-wrap gap-x-5 gap-y-3 md:justify-end">
          {externalLinks.map((link) => <a class="footer-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}
        </div>
        <div class="mt-4 font-mono text-xs text-white/65">© {new Date().getFullYear()} {site.name}</div>
      </div>
    </div>
  </div>
</footer>

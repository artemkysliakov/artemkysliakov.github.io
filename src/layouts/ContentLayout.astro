---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  tags?: string[];
}
const { title, description, published, updated, tags = [] } = Astro.props;
---
<BaseLayout title={title} description={description} type="article">
  <div class="shell pt-8"><Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Нотатки', href: '/blog/' }, { label: title }]} /></div>
  <header class="shell py-14 lg:py-24">
    <span class="eyebrow">Публікація</span>
    <h1 class="page-title mt-5">{title}</h1>
    <p class="lead mt-7">{description}</p>
    <div class="mt-7 flex flex-wrap gap-2">
      <span class="tag">{published?.toLocaleDateString('uk-UA')}</span>
      {updated && <span class="tag">Оновлено {updated.toLocaleDateString('uk-UA')}</span>}
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </header>
  <article class="prose"><slot /></article>
</BaseLayout>

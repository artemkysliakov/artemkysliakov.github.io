---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials, externalLinks } from '../site.config';
import contactBitmoji from '../assets/bitmoji-notes.png';
---
<BaseLayout title="Контакти" description={`Як написати Артему Кислякову — email ${site.email} та профілі в соцмережах.`}>
  <header class="shell grid gap-8 py-14 lg:grid-cols-[1fr_15rem] lg:items-center lg:py-24">
    <div>
      <div class="eyebrow">Контакти</div>
      <h1 class="page-title mt-5">Пишіть. Я читаю все.</h1>
      <p class="lead mt-7">Питання про РАВЛИК чи itnauka, запрошення провести урок або виступити, ідея спільного проєкту, скарга на баг — усе доречно. Якщо напишете ввечері, відповім зранку.</p>
    </div>
    <Image class="mx-auto w-40 rotate-2 drop-shadow-[6px_8px_0_rgba(23,33,60,.15)] lg:w-60" src={contactBitmoji} alt="Бітмоджі пана Артема біля поштової скриньки" width={420} loading="lazy" />
  </header>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">Найпростіше</div><h2 class="mt-3 text-3xl font-black">Пошта</h2></div>
      <div>
        <a class="note block bg-acid transition hover:-translate-y-1" href={`mailto:${site.email}`}>
          <div class="font-mono text-xs font-bold text-coral">email</div>
          <div class="mt-4 text-2xl font-black break-all sm:text-3xl">{site.email}</div>
          <div class="mt-4 leading-relaxed">Натисніть, щоб відкрити поштову програму.</div>
        </a>
        <p class="mt-6 max-w-2xl leading-relaxed text-ink/70">Якщо пишете про помилку в РАВЛИКу чи на itnauka.org — додайте, будь ласка, назву браузера й що саме ви робили перед тим. Це економить нам обом один лист.</p>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">Соцмережі</div><h2 class="mt-3 text-3xl font-black">Де я ще є</h2></div>
      <div class="grid gap-4 sm:grid-cols-2">
        {socials.map((social, index) => (
          <a
            class:list={['desktop-shortcut group min-h-0 justify-between', ['bg-acid', 'bg-mint', 'tone-coral bg-[#ffd1c8]', 'tone-lilac bg-[#d8ddff]'][index % 4]]}
            href={social.href}
            target="_blank"
            rel="noreferrer me"
          >
            <span class="text-xl font-black">{social.label}</span>
            <span class="mt-4 font-mono text-xs text-ink/60">{new URL(social.href).pathname.replace(/^\/|\/$/g, '')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">Проєкти</div><h2 class="mt-3 text-3xl font-black">Сайти, про які найчастіше питають</h2></div>
      <div class="flex flex-wrap gap-4">
        {externalLinks.map((link) => <a class="button" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serializeJsonLd } from '../../lib/security';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const items = await getCollection('projects', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const areaNames = { education: 'Освіта', edtech: 'EdTech' };
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Розробки', item: `${site.url}/developments/` },
      { '@type': 'ListItem', position: 3, name: item.data.title, item: canonical }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: item.data.title,
    description: item.data.description,
    url: item.data.externalUrl ?? canonical,
    inLanguage: 'uk',
    keywords: item.data.tags.join(', '),
    author: { '@type': 'Person', '@id': `${site.url}/#artem`, name: site.name }
  }
];
---
<BaseLayout title={item.data.title} description={item.data.description}>
  <Fragment slot="head"><script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} /></Fragment>

  <div class="shell pt-8"><Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Розробки', href: '/developments/' }, { label: item.data.title }]} /></div>

  <header class="shell py-14 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
      <div>
        <span class="eyebrow">{areaNames[item.data.area] ?? item.data.area}</span>
        <h1 class="page-title mt-5">{item.data.title}</h1>
        <p class="lead mt-7">{item.data.description}</p>
      </div>
      <dl class="card grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        <div><dt class="text-xs font-black tracking-wider text-ink/60 uppercase">Моя роль</dt><dd class="mt-1 text-lg font-extrabold">{item.data.role}</dd></div>
        {item.data.year && <div><dt class="text-xs font-black tracking-wider text-ink/60 uppercase">Період</dt><dd class="mt-1 text-lg font-extrabold">{item.data.year}</dd></div>}
        {item.data.client && <div><dt class="text-xs font-black tracking-wider text-ink/60 uppercase">Клієнт</dt><dd class="mt-1 text-lg font-extrabold">{item.data.client}</dd></div>}
        <div class="flex flex-wrap gap-2">{item.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </dl>
    </div>
    {item.data.externalUrl && <div class="mt-8"><a class="button button-primary" href={item.data.externalUrl} target="_blank" rel="noopener noreferrer">Відкрити розробку ↗</a></div>}
  </header>

  {item.data.cover && (
    <figure class="shell mb-14 lg:mb-20">
      <Image class="w-full rounded-xl border-2 border-ink shadow-[7px_7px_0_#17213c]" src={item.data.cover} alt={item.data.coverAlt ?? `Знімок екрана: ${item.data.title}`} widths={[640, 960, 1280]} sizes="(max-width: 1180px) 92vw, 1100px" loading="eager" />
    </figure>
  )}

  <article class="prose"><Content /></article>

  <nav class="shell mt-12 flex flex-wrap gap-4" aria-label="Далі">
    <a class="button" href="/developments/">← Усі розробки</a>
    <a class="button" href="/contacts/">Написати мені</a>
  </nav>
</BaseLayout>

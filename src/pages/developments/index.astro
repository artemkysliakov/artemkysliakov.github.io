---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import developmentsBitmoji from '../../assets/bitmoji-developments.png';

const items = await getCollection('projects', ({ data }) => !data.draft);
const preferredOrder = ['ravlyk', 'itnauka'];
items.sort((a, b) => preferredOrder.indexOf(a.id) - preferredOrder.indexOf(b.id));

// Проєкти без публічної версії: показуємо чесно, без посилань і без окремих сторінок.
const inProgress = [
  {
    title: 'Навчальний офісний пакет',
    description: 'Текстовий редактор, таблиці й презентації, урізані до того, що реально потрібно на уроці в початковій школі.'
  },
  {
    title: 'Розширення для браузера',
    description: 'Невеликі доповнення, які прибирають зайве з екрана й допомагають вести урок.'
  }
];
---
<BaseLayout title="Розробки" description="Освітні сервіси й активні розробки Артема Кислякова.">
  <header class="shell grid gap-8 py-14 lg:grid-cols-[1fr_17rem] lg:items-center lg:py-24">
    <div>
      <div class="eyebrow">Розробки</div>
      <h1 class="page-title mt-5">Інструменти, яких мені бракувало на уроці.</h1>
      <p class="lead mt-7">Тут мої навчальні сервіси. Два вже працюють відкрито, ще два я доводжу до стану, коли їх можна показувати.</p>
    </div>
    <Image class="mx-auto w-48 -rotate-1 drop-shadow-[6px_8px_0_rgba(23,33,60,.15)] lg:w-68" src={developmentsBitmoji} alt="Бітмоджі пана Артема з ноутбуком та указкою" width={440} loading="lazy" />
  </header>

  <section class="shell border-t border-line pb-14">
    {items.map((project, index) => <ProjectCard project={project} index={index + 1} headingLevel="h2" />)}
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">У роботі</div><h2 class="mt-3 text-3xl font-black">Ще не показував</h2></div>
      <div class="grid gap-5 sm:grid-cols-2">
        {inProgress.map((item, index) => (
          <article class:list={['note', index % 2 ? 'tone-lilac bg-[#d8ddff]' : 'tone-coral bg-[#ffd1c8]']}>
            <div class="font-mono text-xs font-bold text-coral">у роботі</div>
            <h3 class="mt-4 text-xl font-black">{item.title}</h3>
            <p class="mt-3 leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

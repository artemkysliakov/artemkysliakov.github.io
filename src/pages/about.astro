---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/artem-kysliakov.jpg';
import aboutBitmoji from '../assets/bitmoji-about.png';
import { site } from '../site.config';
import { inlineMarkdown } from '../lib/inline';
import page from '../content/pages/about.json';

const noteColors = ['bg-acid', 'bg-mint', 'tone-coral bg-[#ffd1c8]', 'tone-lilac bg-[#d8ddff]'];
/** У текстах сторінок {email} підставляється з site.config. */
const fill = (text: string) => inlineMarkdown(text.replaceAll('{email}', site.email));
---
<BaseLayout title="Про мене" description="Артем Кисляков — учитель інформатики, координатор з інновацій і розробник освітніх ресурсів.">
  <header class="shell grid gap-10 py-14 lg:grid-cols-[1fr_.72fr] lg:items-end lg:py-24">
    <div>
      <div class="eyebrow">{page.eyebrow}</div>
      <h1 class="page-title mt-5">{page.title}</h1>
      <p class="lead mt-7">{page.lead}</p>
    </div>
    <figure class="tape relative rotate-1 rounded-lg border-2 border-ink bg-white p-3 shadow-[7px_7px_0_#17213c]">
      <Image class="aspect-[4/3] w-full object-cover object-[50%_28%]" src={portrait} alt={page.portraitAlt} widths={[600, 900, 1200]} sizes="(max-width: 1024px) 90vw, 38vw" loading="eager" fetchpriority="high" />
    </figure>
  </header>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.intro.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.intro.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.coordinator.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.coordinator.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.facts.heading}</h2>
      <dl class="grid gap-4 sm:grid-cols-2">
        {page.facts.items.map((fact, index) => (
          <div class:list={['note', noteColors[index % noteColors.length]]}>
            <dt class="font-mono text-xs font-bold text-coral">{fact.label}</dt>
            <dd class="mt-3 text-xl leading-tight font-black">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr_auto] lg:items-center">
      <h2 class="text-3xl font-black">{page.work.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.work.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
      <Image class="mx-auto w-40 drop-shadow-[5px_7px_0_rgba(23,33,60,.14)] lg:w-48" src={aboutBitmoji} alt={page.work.bitmojiAlt} width={320} loading="lazy" />
    </div>
  </section>
</BaseLayout>

---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/artem-kysliakov.jpg';
import aboutBitmoji from '../assets/bitmoji-about.png';
import { site } from '../site.config';
import { inlineMarkdown } from '../lib/inline';
import page from '../content/pages/about.json';

const noteColors = ['bg-acid', 'bg-mint', 'tone-coral bg-[#ffd1c8]', 'tone-lilac bg-[#d8ddff]'];

/**
 * Зображення сертифікатів лежать у src/assets/certificates, а в about.json
 * зберігається лише ім'я файлу — щоб редактор міг додавати нові без правок коду.
 */
const certificateImages = import.meta.glob<ImageMetadata>('../assets/certificates/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
  import: 'default'
});
const fileName = (value: string) => value.split('/').pop() ?? value;
const certificateImage = (value: string) =>
  Object.entries(certificateImages).find(([key]) => fileName(key) === fileName(value))?.[1];
/** У текстах сторінок {email} підставляється з site.config. */
const fill = (text: string) => inlineMarkdown(text.replaceAll('{email}', site.email));
---
<BaseLayout title="Про мене" description="Артем Кисляков — учитель інформатики, координатор з інновацій і розробник освітніх ресурсів.">
  <header class="shell grid gap-10 py-14 lg:grid-cols-[1fr_.72fr] lg:items-end lg:py-24">
    <div>
      <div class="eyebrow">{page.eyebrow}</div>
      <h1 class="page-title mt-5">{page.title}</h1>
      <p class="lead mt-7">{page.lead}</p>
    </div>
    <figure class="tape relative rotate-1 rounded-lg border-2 border-ink bg-white p-3 shadow-[7px_7px_0_#17213c]">
      <Image class="aspect-[4/3] w-full object-cover object-[50%_28%]" src={portrait} alt={page.portraitAlt} widths={[600, 900, 1200]} sizes="(max-width: 1024px) 90vw, 38vw" loading="eager" fetchpriority="high" />
    </figure>
  </header>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.intro.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.intro.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.coordinator.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.coordinator.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.facts.heading}</h2>
      <dl class="grid gap-4 sm:grid-cols-2">
        {page.facts.items.map((fact, index) => (
          <div class:list={['note', noteColors[index % noteColors.length]]}>
            <dt class="font-mono text-xs font-bold text-coral">{fact.label}</dt>
            <dd class="mt-3 text-xl leading-tight font-black">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-band">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <div>
          <div class="eyebrow">{page.certificates.eyebrow}</div>
          <h2 class="mt-3 text-3xl font-black">{page.certificates.heading}</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-ink/70" set:html={fill(page.certificates.note)} />
      </div>
      <ul class="m-0 mt-9 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {page.certificates.items.map((item) => {
          const image = certificateImage(item.image);
          return (
            <li class="note flex flex-col gap-4">
              {image && (
                <div class="mx-auto grid w-full max-w-56 place-items-center rounded-md border-2 border-ink/15 bg-[#fdfcf7] p-3">
                  <Image class="h-36 w-auto max-w-full object-contain" src={image} alt={item.imageAlt} widths={[240, 480]} sizes="240px" loading="lazy" />
                </div>
              )}
              <div>
                <h3 class="text-base leading-snug font-black">{item.title}</h3>
                <p class="mt-2 font-mono text-xs leading-relaxed text-ink/60">{item.issuer}</p>
                <p class="mt-1 font-mono text-xs font-bold text-coral">{item.date}</p>
                {item.detail && <p class="mt-3 text-sm leading-relaxed text-ink/75">{item.detail}</p>}
              </div>
              {(item.url || item.file) && (
                <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1">
                  {item.url && (
                    <a class="text-sm font-bold text-coral underline decoration-2 underline-offset-4" href={item.url} target="_blank" rel="noopener noreferrer">{page.certificates.verifyLabel}</a>
                  )}
                  {item.file && (
                    <a class="text-sm font-bold text-coral underline decoration-2 underline-offset-4" href={item.file} target="_blank" rel="noopener">{page.certificates.fileLabel}</a>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr_auto] lg:items-center">
      <h2 class="text-3xl font-black">{page.work.heading}</h2>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.work.paragraphs.map((text) => <p set:html={fill(text)} />)}
      </div>
      <Image class="mx-auto w-40 drop-shadow-[5px_7px_0_rgba(23,33,60,.14)] lg:w-48" src={aboutBitmoji} alt={page.work.bitmojiAlt} width={320} loading="lazy" />
    </div>
  </section>
</BaseLayout>

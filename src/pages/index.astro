---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { serializeJsonLd } from '../lib/security';
import ProjectCard from '../components/ProjectCard.astro';
import portrait from '../assets/artem-kysliakov.jpg';
import learningBitmoji from '../assets/bitmoji-learning.png';
import { publications } from '../data/publications';
import { site, socials, externalLinks } from '../site.config';
import { inlineMarkdown } from '../lib/inline';
import page from '../content/pages/home.json';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = ['ravlyk', 'itnauka'].map((id) => allProjects.find((item) => item.id === id)).filter((item) => item !== undefined);
const featuredPublications = publications.slice(0, 3);

const folderStyles = [
  { color: 'bg-acid', rotate: 'rotate-[-1deg]', tone: '' },
  { color: 'bg-mint', rotate: 'rotate-[1deg]', tone: '' },
  { color: 'bg-[#ffd1c8]', rotate: 'rotate-[-.5deg]', tone: 'tone-coral' }
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#artem`,
    name: site.name,
    alternateName: site.shortName,
    jobTitle: site.role,
    email: `mailto:${site.email}`,
    url: `${site.url}/`,
    knowsAbout: ['інформатика', 'EdTech', 'maker education', 'AI в освіті'],
    sameAs: [...socials.map((item) => item.href), ...externalLinks.map((item) => item.href)]
  }
};
---

<BaseLayout description={page.description}>
  <Fragment slot="head"><script type="application/ld+json" set:html={serializeJsonLd(person)} /></Fragment>

  <section class="shell py-10 lg:py-16">
    <div class="desktop-window">
      <div class="window-bar">
        <span class="flex min-w-0 items-center gap-3"><span class="window-controls" aria-hidden="true"><i class="window-control"></i><i class="window-control"></i><i class="window-control"></i></span><span class="truncate">profile.exe</span></span>
        <span class="hidden text-ink/60 sm:block">artem://home</span>
      </div>
      <div class="grid gap-10 p-6 sm:p-9 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,.7fr)] lg:items-center lg:p-12">
        <div class="min-w-0">
          <div class="mb-6 inline-flex rotate-1 items-center gap-2 rounded-full border-2 border-ink bg-white px-3 py-1.5 font-mono text-xs font-bold shadow-[3px_3px_0_#17213c]"><span class="size-2 rounded-full bg-[#26a269]"></span> {page.hero.badge}</div>
          <h1 class="display-title">{page.hero.titleLine1}<br /><span class="scribble">{page.hero.titleLine2}</span></h1>
          <p class="mt-8 max-w-2xl text-2xl leading-tight font-black sm:text-3xl">{page.hero.statement}</p>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/75" set:html={inlineMarkdown(page.hero.text)} />
          <div class="mt-8 flex flex-wrap gap-4">
            <a class="button button-primary" href={page.hero.primaryButton.href}>{page.hero.primaryButton.label}</a>
            <a class="button" href={page.hero.secondaryButton.href}>{page.hero.secondaryButton.label}</a>
          </div>
        </div>
        <figure class="tape relative m-0 min-w-0 rotate-2 rounded-lg border-2 border-ink bg-white p-3 shadow-[9px_9px_0_#17213c] transition hover:rotate-0">
          <Image class="aspect-[4/5] w-full rounded-sm object-cover object-[52%_24%] grayscale-[15%]" src={portrait} alt={page.hero.portraitAlt} widths={[480, 720, 960]} sizes="(max-width: 1024px) 90vw, 35vw" loading="eager" fetchpriority="high" />
          <figcaption class="flex items-center justify-between gap-4 px-1 pt-3 font-mono text-[.68rem] text-ink/60"><span>{page.hero.portraitCaption}</span><span class="-rotate-6 text-xl" aria-hidden="true">↳</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="start" class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[1fr_13rem] lg:items-end">
      <div>
        <div class="eyebrow">{page.folders.eyebrow}</div>
        <h2 class="section-title mt-3">{page.folders.heading}</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {page.folders.items.map((item, index) => (
            <a class:list={['desktop-shortcut folder-shortcut group', folderStyles[index].tone, folderStyles[index].rotate, folderStyles[index].color]} href={item.href}>
              <span class="shortcut-icon" aria-hidden="true">
                {index === 0 && <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path></svg>}
                {index === 1 && <svg viewBox="0 0 24 24"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"></path></svg>}
                {index === 2 && <svg viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>}
              </span>
              <h3 class="mt-8 text-2xl font-black">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink/70">{item.text}</p>
              <span class="mt-auto pt-6 font-bold group-hover:text-coral">{item.linkLabel}</span>
            </a>
          ))}
        </div>
      </div>
      <Image class="mx-auto hidden w-full max-w-52 -rotate-2 drop-shadow-[6px_8px_0_rgba(23,33,60,.18)] lg:block" src={learningBitmoji} alt={page.folders.bitmojiAlt} width={420} loading="lazy" />
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-9 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">{page.now.eyebrow}</div><h2 class="mt-3 text-3xl font-black">{page.now.heading}</h2></div>
      <div class="grid gap-5 sm:grid-cols-2">
        {page.now.items.map((item) => (
          <article class="note bg-white">
            <div class="font-mono text-xs font-bold text-coral">{item.kicker}</div>
            <h3 class="mt-6 text-2xl font-black">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/70" set:html={inlineMarkdown(item.text)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell">
      <div class="mb-7 flex items-end justify-between gap-5"><div><div class="eyebrow">{page.projects.eyebrow}</div><h2 class="section-title mt-3">{page.projects.heading}</h2></div><a class="hidden font-bold underline decoration-2 underline-offset-4 sm:block" href="/developments/">{page.projects.allLabel}</a></div>
      <div>{projects.map((project, index) => <ProjectCard project={project} index={index + 1} headingLevel="h3" />)}</div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">{page.notes.eyebrow}</div><h2 class="mt-3 text-3xl font-black">{page.notes.heading}</h2></div>
      <div class="grid gap-4">
        {featuredPublications.map((post, index) => (
          <a class:list={['group note grid gap-3 transition hover:-translate-y-1 sm:grid-cols-[6rem_1fr_auto]', index % 2 ? 'rotate-[.4deg]' : 'rotate-[-.4deg]']} href={post.href} target="_blank" rel="noopener noreferrer">
            <span class="font-mono text-xs font-bold text-coral">{post.topic}</span>
            <div>
              <h3 class="text-xl font-black transition group-hover:text-coral">{post.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink/70">{post.description}</p>
            </div>
            <span class="text-xl font-black" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

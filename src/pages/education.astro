---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import lessonsBitmoji from '../assets/bitmoji-lessons.png';
import { inlineMarkdown } from '../lib/inline';
import page from '../content/pages/education.json';

const noteColors = ['bg-acid', 'bg-mint', 'tone-coral bg-[#ffd1c8]', 'tone-lilac bg-[#d8ddff]'];
---
<BaseLayout title="Уроки" description="Як Артем Кисляков викладає інформатику в початковій школі та розробляє навчальні матеріали.">
  <header class="shell grid gap-8 py-14 lg:grid-cols-[1fr_16rem] lg:items-center lg:py-24">
    <div>
      <div class="eyebrow">{page.eyebrow}</div>
      <h1 class="page-title mt-5">{page.title}</h1>
      <p class="lead mt-7">{page.lead}</p>
    </div>
    <Image class="mx-auto w-44 -rotate-2 drop-shadow-[6px_8px_0_rgba(23,33,60,.15)] lg:w-64" src={lessonsBitmoji} alt={page.bitmojiAlt} width={420} loading="lazy" />
  </header>

  <section class="section-band">
    <div class="shell grid gap-10 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">{page.goodLesson.eyebrow}</div><h2 class="mt-3 text-3xl font-black">{page.goodLesson.heading}</h2></div>
      <div class="note bg-white text-xl leading-relaxed">
        <p set:html={inlineMarkdown(page.goodLesson.text)} />
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-10 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">{page.stories.eyebrow}</div><h2 class="mt-3 text-3xl font-black">{page.stories.heading}</h2></div>
      <div class="max-w-3xl space-y-5 text-lg leading-relaxed text-ink/80">
        {page.stories.paragraphs.map((text) => <p set:html={inlineMarkdown(text)} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-10 lg:grid-cols-[14rem_1fr]">
      <div><div class="eyebrow">{page.principles.eyebrow}</div><h2 class="mt-3 text-3xl font-black">{page.principles.heading}</h2></div>
      <div class="grid gap-5 sm:grid-cols-2">
        {page.principles.items.map((item, index) => (
          <article class:list={['note', noteColors[index % noteColors.length]]}>
            <h3 class="text-xl font-black">{item.title}</h3>
            <p class="mt-3 leading-relaxed" set:html={inlineMarkdown(item.text)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="shell grid gap-8 lg:grid-cols-[14rem_1fr]">
      <h2 class="text-3xl font-black">{page.tools.heading}</h2>
      <div>
        <p class="max-w-3xl text-3xl leading-snug font-black">{page.tools.statement}</p>
        <p class="mt-5 max-w-2xl leading-relaxed text-ink/75" set:html={inlineMarkdown(page.tools.text)} />
        <a class="button button-primary mt-7" href={page.tools.buttonHref}>{page.tools.buttonLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="360° / VR" description="Архів 360°/VR-проєктів Артема Кислякова зараз готується до публікації.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="shell py-16 lg:py-28"><div class="desktop-window mx-auto max-w-4xl"><div class="window-bar"><span class="window-dots pl-13">archive.zip</span><span class="text-ink/45">360° / VR</span></div><div class="p-7 sm:p-12"><div class="eyebrow">Архів тимчасово закритий</div><h1 class="page-title mt-5">Тут ще наводиться лад.</h1><p class="lead mt-7">360°/VR був важливою частиною моєї роботи, але зараз це лише один-два проєкти на рік. Я поверну цей розділ, коли підготую точний перелік робіт і матеріали, які можна показувати публічно.</p><a class="button button-primary mt-8" href="/projects/">До освітніх проєктів</a></div></div></section>
</BaseLayout>

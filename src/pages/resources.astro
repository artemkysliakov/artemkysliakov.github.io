---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const items = await getCollection('resources', ({ data }) => !data.draft);
const audienceNames = { teachers: 'Учителям', students: 'Учням', parents: 'Батькам' };
---
<BaseLayout title="Матеріали" description="Навчальні інструменти та ресурси Артема Кислякова для вчителів і учнів.">
  <header class="shell py-14 lg:py-24"><div class="eyebrow">Матеріали</div><h1 class="page-title mt-5">Ресурси, які можна використати на уроці.</h1><p class="lead mt-7">Навчальні середовища, вебінструменти, гайди й матеріали для вчителів та учнів.</p></header>
  <section class="shell border-t border-line pb-12 lg:pb-24">{items.map((item, index) => <a class="group grid gap-4 border-b border-line py-7 md:grid-cols-[3rem_9rem_1fr_auto]" href={item.data.externalUrl ?? '#'} target={item.data.externalUrl ? '_blank' : undefined} rel={item.data.externalUrl ? 'noreferrer' : undefined}><span class="font-display text-lg text-ink/35">{String(index + 1).padStart(2, '0')}</span><div><div class="eyebrow">{item.data.resourceType}</div><div class="mt-2 flex flex-wrap gap-2">{item.data.audience.map((audience) => <span class="text-xs text-ink/50">{audienceNames[audience] ?? audience}</span>)}</div></div><div><h2 class="font-display text-3xl tracking-[-0.035em] transition group-hover:text-coral">{item.data.title}</h2><p class="mt-3 max-w-2xl leading-relaxed text-ink/62">{item.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</section>
</BaseLayout>

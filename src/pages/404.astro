---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'На головну' },
  { href: '/developments/', label: 'Розробки' },
  { href: '/education/', label: 'Уроки' },
  { href: '/contacts/', label: 'Контакти' }
];
---
<BaseLayout title="404" description="Такої сторінки немає — але є равлик, який малює квадрат.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

  <section class="shell py-12 lg:py-20">
    <div class="desktop-window">
      <div class="window-bar">
        <span class="flex min-w-0 items-center gap-3"><span class="window-controls" aria-hidden="true"><i class="window-control"></i><i class="window-control"></i><i class="window-control"></i></span><span class="truncate">404.exe</span></span>
        <span class="hidden text-ink/60 sm:block">файл не знайдено</span>
      </div>

      <div class="grid gap-10 p-6 sm:p-9 lg:grid-cols-[minmax(0,1fr)_minmax(19rem,.85fr)] lg:p-12">
        <div class="min-w-0">
          <div class="eyebrow">Помилка 404</div>
          <h1 class="mt-4 text-[clamp(3rem,7vw,5.5rem)] leading-[.9] font-black tracking-[-0.06em]">Сторінки<br /><span class="scribble">немає.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink/75">Можливо, адресу набрано з помилкою, а можливо, я перейменував сторінку й забув поставити перенаправлення. Друге ймовірніше.</p>
          <p class="mt-4 max-w-xl leading-relaxed text-ink/70">Поки ви тут — ось як виглядає програма на РАВЛИКу. Змініть числа чи команди й натисніть «Запустити».</p>
          <div class="mt-7 flex flex-wrap gap-4">
            {links.map((link, index) => <a class:list={['button', index === 0 && 'button-primary']} href={link.href}>{link.label}</a>)}
          </div>
        </div>

        <div class="min-w-0">
          <label class="eyebrow" for="ravlyk-code">програма</label>
          <textarea
            id="ravlyk-code"
            class="mt-3 h-40 w-full resize-none rounded-lg border-2 border-ink bg-[#17213c] p-4 font-mono text-sm leading-relaxed text-[#d9f45d] shadow-[4px_4px_0_#17213c] focus:outline-none"
            spellcheck="false"
            data-ravlyk-code
          >повторити 4 (
  вперед 80
  праворуч 90
)</textarea>
          <p class="mt-3 font-mono text-xs leading-relaxed text-ink/60">Команди: вперед, назад, праворуч, ліворуч і повторити N ( … )</p>
          <div class="mt-4 flex items-center gap-3">
            <button class="button button-primary" type="button" data-ravlyk-run>Запустити ▶</button>
            <span class="font-mono text-xs text-ink/60" data-ravlyk-status aria-live="polite"></span>
          </div>
          <canvas
            class="mt-4 w-full rounded-lg border-2 border-ink bg-white shadow-[4px_4px_0_#17213c]"
            width="480"
            height="360"
            data-ravlyk-canvas
            role="img"
            aria-label="Полотно, на якому виконується програма РАВЛИКа"
          ></canvas>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Мініатюрний інтерпретатор базового синтаксису РАВЛИКа.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ravlyk-canvas]');
  const input = document.querySelector<HTMLTextAreaElement>('[data-ravlyk-code]');
  const runButton = document.querySelector<HTMLButtonElement>('[data-ravlyk-run]');
  const status = document.querySelector<HTMLElement>('[data-ravlyk-status]');

  if (canvas && input && runButton && status) {
    const context = canvas.getContext('2d')!;

    type CommandName = 'вперед' | 'назад' | 'праворуч' | 'ліворуч';
    type Command = { name: CommandName; value: number };

    const parse = (source: string): Command[] => {
      const tokens = source
        .replace(/\/\/.*$/gm, '')
        .replace(/([()])/g, ' $1 ')
        .trim()
        .split(/\s+/)
        .filter(Boolean);
      let position = 0;

      const readNumber = (command: string) => {
        const token = tokens[position++];
        const value = Number(token);
        if (!token || !Number.isFinite(value)) throw new Error(`Після «${command}» потрібне число`);
        return value;
      };

      const readBlock = (insideRepeat = false): Command[] => {
        const commands: Command[] = [];

        while (position < tokens.length) {
          const word = tokens[position++].toLowerCase();

          if (word === ')') {
            if (!insideRepeat) throw new Error('Зайва закривна дужка');
            return commands;
          }

          if (word === 'повторити') {
            const count = readNumber(word);
            if (!Number.isInteger(count) || count < 0) throw new Error('Кількість повторень має бути цілим невід’ємним числом');
            if (tokens[position++] !== '(') throw new Error('Після кількості повторень потрібна дужка «(»');
            const nested = readBlock(true);
            for (let pass = 0; pass < Math.min(count, 64); pass += 1) {
              commands.push(...nested);
              if (commands.length > 2000) throw new Error('Забагато команд для цієї маленької версії РАВЛИКа');
            }
            continue;
          }

          if (['вперед', 'назад', 'праворуч', 'ліворуч'].includes(word)) {
            commands.push({ name: word as CommandName, value: readNumber(word) });
            continue;
          }

          if (word === '(') throw new Error('Дужка «(» має стояти після команди «повторити»');
          throw new Error(`Невідома команда: «${word}»`);
        }

        if (insideRepeat) throw new Error('Бракує закривної дужки «)»');
        return commands;
      };

      return readBlock();
    };

    const draw = (commands: Command[]) => {
      const { width, height } = canvas;
      context.clearRect(0, 0, width, height);
      context.lineWidth = 3;
      context.lineCap = 'round';
      context.lineJoin = 'round';
      context.strokeStyle = '#f05a3f';

      let x = width / 2 - 40;
      let y = height / 2 + 40;
      let angle = -90;

      context.beginPath();
      context.moveTo(x, y);
      for (const command of commands) {
        if (command.name === 'вперед' || command.name === 'назад') {
          const distance = command.name === 'назад' ? -command.value : command.value;
          x += Math.cos((angle * Math.PI) / 180) * distance;
          y += Math.sin((angle * Math.PI) / 180) * distance;
          context.lineTo(x, y);
        } else if (command.name === 'праворуч') {
          angle += command.value;
        } else if (command.name === 'ліворуч') {
          angle -= command.value;
        }
      }
      context.stroke();

      context.fillStyle = '#17213c';
      context.beginPath();
      context.arc(x, y, 5, 0, Math.PI * 2);
      context.fill();
    };

    const execute = () => {
      try {
        const commands = parse(input.value);
        draw(commands);
        status.textContent = commands.length
          ? `виконано команд: ${commands.length}`
          : 'команд не знайдено — спробуйте «вперед 80»';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Не вдалося прочитати програму';
      }
    };

    runButton.addEventListener('click', execute);
    execute();
  }
</script>
